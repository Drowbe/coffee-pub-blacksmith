{{!-- Grid of boxes, each a caption above a value. Ability scores are one use;
      currency, resources, and counts are others. Column count comes from the
      renderer rather than being inferred by the grid. --}}
<div class="blacksmith-part-tiles" style="grid-template-columns: repeat({{columns}}, 1fr)">
    {{#each items}}
    <div class="blacksmith-part-tile">
        <div class="blacksmith-part-tile-label">{{{this.label}}}</div>
        <div class="blacksmith-part-tile-value">{{{this.value}}}</div>
    </div>
    {{/each}}
</div>
