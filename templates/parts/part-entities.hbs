{{!-- Rows of image, document link, optional count. --}}
<div class="cpb-part-entities">
    {{#each items}}
    <div class="cpb-part-entity">
        {{#if this.img}}<img class="cpb-part-entity-img" src="{{this.img}}" alt="" />{{/if}}
        <div class="cpb-part-entity-label">
            {{#if this.count}}<span class="cpb-part-entity-count">{{this.count}} &times;</span> {{/if}}{{{this.label}}}
        </div>
    </div>
    {{/each}}
</div>
