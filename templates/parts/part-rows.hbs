{{!-- Detail rows: an optional thumbnail or icon, a label that may be a document
      link, an optional sub-line, and an optional trailing value or button.
      One part rather than two, because "a list of creatures" and "a list of
      conditions" differ only in which of these fields are filled. --}}
<div class="cpb-part-rows{{#if plain}} cpb-rows-plain{{/if}}">
    {{#each items}}
    <div class="cpb-part-row{{#if this.tone}} cpb-tone-{{this.tone}}{{/if}}{{#if this.emphasis}} cpb-emphasis{{/if}}{{#if this.animation}} cpb-anim-{{this.animation}}{{/if}}">
        {{#if this.img}}<img class="cpb-part-row-img{{#if this.framed}} cpb-row-img-framed{{/if}}{{#if this.cover}} cpb-row-img-cover{{/if}}" src="{{this.img}}" alt="" />{{/if}}
        {{#if this.icon}}<i class="cpb-part-row-icon {{this.icon}}"></i>{{/if}}
        <div class="cpb-part-row-text">
            <div class="cpb-part-row-label">
                {{#if this.count}}<span class="cpb-part-row-count">{{this.count}} &times;</span> {{/if}}{{{this.label}}}
            </div>
            {{#if this.sublabel}}<div class="cpb-part-row-sublabel">{{{this.sublabel}}}</div>{{/if}}
        </div>
        {{#if this.trailing}}<div class="cpb-part-row-trailing{{#if this.trailingSize}} cpb-trailing-{{this.trailingSize}}{{/if}}">{{{this.trailing}}}</div>{{/if}}
        {{#if this.trailingIcon}}<i class="cpb-part-row-trailing-icon {{this.trailingIcon}}"></i>{{/if}}
        {{#if this.action}}
        <button type="button" class="cpb-part-row-action chat-button"
                data-cpb-module="{{this.moduleId}}" data-cpb-action="{{this.action}}"
                {{#if this.value}}data-cpb-value="{{this.value}}"{{/if}}>
            <i class="{{#if this.actionIcon}}{{this.actionIcon}}{{else}}fa-solid fa-ellipsis{{/if}}"></i>
        </button>
        {{/if}}
    </div>
    {{/each}}
</div>
