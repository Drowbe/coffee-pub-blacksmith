{{!-- Instruction line and buttons. Buttons carry the namespaced attributes the
      delegated dispatcher matches on; `data-action` is deliberately not used,
      because ApplicationV2 already claims it. --}}
{{#if instruction}}<div class="blacksmith-part-actions-instruction">{{{instruction}}}</div>{{/if}}
<div class="blacksmith-card-buttons">
    {{#each buttons}}
    <button type="button" class="card-button"
            data-blacksmith-module="{{this.moduleId}}" data-blacksmith-action="{{this.action}}"
            {{#if this.value}}data-blacksmith-value="{{this.value}}"{{/if}}
            {{#if this.disabled}}disabled{{/if}}>
        {{#if this.icon}}<i class="{{this.icon}}"></i> {{/if}}{{this.label}}
    </button>
    {{/each}}
</div>
