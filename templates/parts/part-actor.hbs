{{!-- Actor chip: avatar, primary name, secondary line. --}}
<div class="container-user">
    {{#if img}}<img class="token-image" src="{{img}}" alt="" />{{/if}}
    <div class="token-text-wrapper">
        <span class="token-name">{{name}}</span>
        {{#if subtitle}}<span class="token-character">{{subtitle}}</span>{{/if}}
    </div>
</div>
