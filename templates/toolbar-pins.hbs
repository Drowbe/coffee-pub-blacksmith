{{! Journal page pins toolbar: Pin Page + placement toggles, then icons, then tags }}
<div class="journal-page-pins-bar" data-page-id="{{pageId}}" data-placement-icon="fa-solid fa-book-open" data-pin-mode="single" data-access-mode="gm" data-visibility-mode="visible">
    <div class="journal-page-pins-bar-row journal-page-pins-actions-row">
        <a class="header-control icon journal-entry-pin-button" href="#" data-journal-id="{{journalId}}" data-tooltip="Pin this journal on the current scene (opens like the sidebar; first page when opened)">
            <i class="fa-solid fa-book"></i> Pin Journal
        </a>
        <a class="header-control icon journal-page-pin-button" href="#" data-tooltip="Pin this journal page to the current scene">
            <i class="fa-solid fa-map-pin"></i> Pin Page
        </a>
        <div class="journal-page-pins-placement-toggles">
            <button type="button" class="journal-page-pin-toggle journal-page-pin-mode-toggle" data-pin-mode="single" data-tooltip="Placement: Single">
                <i class="fa-solid fa-map-pin"></i>
            </button>
            <button type="button" class="journal-page-pin-toggle journal-page-pin-access-toggle" data-access-mode="gm" data-tooltip="Pin editing: GM only">
                <i class="fa-solid fa-user-shield"></i>
            </button>
            <button type="button" class="journal-page-pin-toggle journal-page-pin-visibility-toggle" data-visibility-mode="visible" data-tooltip="Pin visibility: Visible">
                <i class="fa-solid fa-eye"></i>
            </button>
        </div>
    </div>
    <div class="journal-page-pins-bar-row journal-page-pins-icons-row">
        <div class="journal-page-pins-icon-options">
            <button type="button" class="journal-page-pin-icon-option" data-placement-icon="__journal-page-image__" data-tooltip="Use first image from page"><i class="fa-solid fa-image"></i></button>
            <button type="button" class="journal-page-pin-icon-option selected" data-placement-icon="fa-solid fa-book-open" data-tooltip="Book (default)"><i class="fa-solid fa-book-open"></i></button>
            <button type="button" class="journal-page-pin-icon-option" data-placement-icon="fa-solid fa-map" data-tooltip="Map"><i class="fa-solid fa-map"></i></button>
            <button type="button" class="journal-page-pin-icon-option" data-placement-icon="fa-solid fa-shield" data-tooltip="Shield"><i class="fa-solid fa-shield"></i></button>
            <button type="button" class="journal-page-pin-icon-option" data-placement-icon="fa-solid fa-store" data-tooltip="Store"><i class="fa-solid fa-store"></i></button>
            <button type="button" class="journal-page-pin-icon-option" data-placement-icon="fa-solid fa-basket-shopping" data-tooltip="Shop"><i class="fa-solid fa-basket-shopping"></i></button>
            <button type="button" class="journal-page-pin-icon-option" data-placement-icon="fa-solid fa-skull" data-tooltip="Skull"><i class="fa-solid fa-skull"></i></button>
            <button type="button" class="journal-page-pin-icon-option" data-placement-icon="fa-solid fa-bookmark" data-tooltip="Bookmark"><i class="fa-solid fa-bookmark"></i></button>
            <button type="button" class="journal-page-pin-icon-option" data-placement-icon="fa-solid fa-droplet" data-tooltip="Droplet"><i class="fa-solid fa-droplet"></i></button>
            <button type="button" class="journal-page-pin-icon-option" data-placement-icon="fa-solid fa-fire" data-tooltip="Fire"><i class="fa-solid fa-fire"></i></button>
            <button type="button" class="journal-page-pin-icon-option" data-placement-icon="fa-solid fa-flag" data-tooltip="Flag"><i class="fa-solid fa-flag"></i></button>
            <button type="button" class="journal-page-pin-icon-option" data-placement-icon="fa-solid fa-flask" data-tooltip="Flask"><i class="fa-solid fa-flask"></i></button>
            <button type="button" class="journal-page-pin-icon-option" data-placement-icon="fa-solid fa-house" data-tooltip="House"><i class="fa-solid fa-house"></i></button>
            <button type="button" class="journal-page-pin-icon-option" data-placement-icon="fa-solid fa-seedling" data-tooltip="Seedling"><i class="fa-solid fa-seedling"></i></button>
            <button type="button" class="journal-page-pin-icon-option" data-placement-icon="fa-solid fa-beer-mug-empty" data-tooltip="Beer"><i class="fa-solid fa-beer-mug-empty"></i></button>
            <button type="button" class="journal-page-pin-icon-option" data-placement-icon="fa-sharp fa-solid fa-swords" data-tooltip="Swords"><i class="fa-sharp fa-solid fa-swords"></i></button>
            <button type="button" class="journal-page-pin-icon-option" data-placement-icon="fa-solid fa-treasure-chest" data-tooltip="Treasure chest"><i class="fa-solid fa-treasure-chest"></i></button>
            <button type="button" class="journal-page-pin-icon-option" data-placement-icon="fa-solid fa-paw-claws" data-tooltip="Paw claws"><i class="fa-solid fa-paw-claws"></i></button>
            <button type="button" class="journal-page-pin-icon-option" data-placement-icon="fa-solid fa-mushroom" data-tooltip="Mushroom"><i class="fa-solid fa-mushroom"></i></button>
            <button type="button" class="journal-page-pin-icon-option" data-placement-icon="fa-sharp fa-solid fa-helmet-battle" data-tooltip="Helmet"><i class="fa-sharp fa-solid fa-helmet-battle"></i></button>
        </div>
    </div>
    <div class="journal-page-pins-tag-row">
        {{! Tag chips injected dynamically by _populateTagChips }}
    </div>
</div>
