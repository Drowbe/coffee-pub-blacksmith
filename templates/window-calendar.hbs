{{!-- Calendar — a month of the world calendar, with the month's events beside it.

      Owned by scripts/window-calendar.js and styles/window-calendar.css.

      Every label here is read from `game.time.calendar` and localized: the month
      name, the weekday abbreviations, the number of columns. Nothing is hardcoded
      to a Gregorian week, because a world is free to declare a tenday.

      The grid is a CSS grid whose column count comes from the calendar, set as a
      custom property rather than a class so any week length works without a
      stylesheet that enumerates them. --}}

{{#if available}}
<div class="blacksmith-calendar">

    <div class="blacksmith-calendar-header">
        <span class="blacksmith-calendar-navgroup">
            <button type="button" class="blacksmith-calendar-nav" data-action="calendarPrevYear"
                    data-tooltip="Previous year">
                <i class="fa-solid fa-angles-left"></i>
            </button>
            <button type="button" class="blacksmith-calendar-nav" data-action="calendarPrev"
                    data-tooltip="Previous month">
                <i class="fa-solid fa-chevron-left"></i>
            </button>
        </span>

        <div class="blacksmith-calendar-title">
            <span class="blacksmith-calendar-month">{{monthName}}</span>
            <span class="blacksmith-calendar-year">{{yearLabel}}{{#if isLeapYear}} <i class="fa-solid fa-asterisk blacksmith-calendar-leap" data-tooltip="A leap year in this calendar"></i>{{/if}}</span>
            {{#if seasonName}}<span class="blacksmith-calendar-season">{{seasonName}}</span>{{/if}}
        </div>

        <span class="blacksmith-calendar-navgroup">
            <button type="button" class="blacksmith-calendar-nav" data-action="calendarNext"
                    data-tooltip="Next month">
                <i class="fa-solid fa-chevron-right"></i>
            </button>
            <button type="button" class="blacksmith-calendar-nav" data-action="calendarNextYear"
                    data-tooltip="Next year">
                <i class="fa-solid fa-angles-right"></i>
            </button>
        </span>
    </div>

    <div class="blacksmith-calendar-body">

        <div class="blacksmith-calendar-main">
            {{!-- Weekday header and day grid are SEPARATE grids sharing a column
                  template. One grid would make `grid-auto-rows: 1fr` stretch the
                  header row along with the days when the window is tall. --}}
            <div class="blacksmith-calendar-weekdays" style="--bc-columns: {{columns}};">
                {{#each weekdays}}
                <div class="blacksmith-calendar-weekday" data-tooltip="{{this.name}}">{{this.abbreviation}}</div>
                {{/each}}
            </div>

            <div class="blacksmith-calendar-grid" style="--bc-columns: {{columns}};">
                {{#each cells}}
                    {{#if this.blank}}
                    <div class="blacksmith-calendar-day is-blank"></div>
                    {{else}}
                    {{!-- Everyone gets a button: clicking SELECTS a day, which is
                          reading rather than writing. Right-click adds an event, which
                          players may also do -- the write is proxied to the GM.
                          TODAY and SELECTED are different marks on purpose. --}}
                    <button type="button"
                            class="blacksmith-calendar-day{{#if this.isToday}} is-today{{/if}}{{#if this.isSelected}} is-selected{{/if}}{{#if this.hasEvents}} has-events{{/if}}"
                            data-action="calendarPickDay"
                            data-day="{{this.dayIndex}}"
                            data-tooltip="{{#if this.hasEvents}}{{this.eventTooltip}}<br>{{/if}}Click to select &middot; right-click to add an event">{{this.label}}</button>
                    {{/if}}
                {{/each}}
            </div>
        </div>

        {{!-- THIS MONTH'S EVENTS. The grid says where they are; this says what they
              are, which is the question a marker cannot answer on its own. --}}
        <div class="blacksmith-calendar-side">
            <div class="blacksmith-calendar-events-title">This month</div>
            {{#if events.length}}
            <div class="blacksmith-calendar-events">
                {{#each events}}
                <div class="blacksmith-calendar-event">
                    <span class="blacksmith-calendar-event-day">{{this.dayLabel}}</span>
                    <span class="blacksmith-calendar-event-name" data-tooltip="{{this.description}}">{{this.name}}</span>
                    {{#if this.canEdit}}
                    <button type="button" class="blacksmith-calendar-event-edit"
                            data-action="calendarEditEvent" data-event-id="{{this.id}}"
                            data-tooltip="Edit this event">
                        <i class="fa-solid fa-pen"></i>
                    </button>
                    <button type="button" class="blacksmith-calendar-event-delete"
                            data-action="calendarDeleteEvent" data-event-id="{{this.id}}"
                            data-tooltip="Delete this event">
                        <i class="fa-solid fa-xmark"></i>
                    </button>
                    {{/if}}
                    <span class="blacksmith-calendar-event-recurrence">{{this.timeLabel}} &middot; {{this.recurrenceLabel}}{{#if this.authorName}} &middot; {{this.authorName}}{{/if}}</span>
                </div>
                {{/each}}
            </div>
            {{else}}
            <div class="blacksmith-calendar-empty">Nothing this month.</div>
            {{/if}}
        </div>

    </div>

    <div class="blacksmith-calendar-footer">
        <span class="blacksmith-calendar-today-label">Today: {{todayLabel}}</span>
        <span class="blacksmith-calendar-footer-actions">
            {{#unless viewingNow}}
            <button type="button" class="blacksmith-calendar-jump" data-action="calendarToday">
                <i class="fa-solid fa-location-crosshairs"></i> Back to today
            </button>
            {{/unless}}
            {{!-- Both act on the SELECTED day, which is why selection is marked
                  separately from today: the button has a visible subject. --}}
            {{#if hasSelection}}
                {{#if isGM}}
                <button type="button" class="blacksmith-calendar-jump" data-action="calendarGoToSelected"
                        data-tooltip="Move the world to {{selectedLabel}}, keeping the time of day">
                    <i class="fa-solid fa-forward"></i> Go to {{selectedLabel}}
                </button>
                {{/if}}
            <button type="button" class="blacksmith-calendar-jump"
                    data-action="calendarAddEvent" data-day="{{selectedDayIndex}}"
                    data-tooltip="Add an event on {{selectedLabel}}">
                <i class="fa-solid fa-plus"></i> Add event
            </button>
            {{else}}
            <span class="blacksmith-calendar-hint">Select a day</span>
            {{/if}}
        </span>
    </div>

</div>
{{else}}
<div class="blacksmith-calendar is-unavailable">
    <p>The world calendar is not available yet.</p>
</div>
{{/if}}
