{{!-- **************** PRINMARY BAR **************** --}}

<div class="blacksmith-menubar-container {{#if secondaryBar.isOpen}}has-secondary{{/if}}">
    {{!-- LEFT ZONE --}}
    <div class="blacksmith-menubar-left">
        {{#each toolsByZone.left}}
            {{#each this}}
                {{#each tools}}
                <div class="button {{name}} button-active{{#if (and toggleable active)}} tool-active{{/if}}" data-tooltip="{{#if tooltip}}{{tooltip}}{{else}}{{title}}{{/if}}" data-tool="{{name}}" data-tool-id="{{toolId}}"{{#if (or buttonNormalTint buttonSelectedTint)}} style="{{#if buttonNormalTint}}--button-normal-tint: {{buttonNormalTint}};{{/if}}{{#if buttonSelectedTint}} --button-selected-tint: {{buttonSelectedTint}};{{/if}}"{{/if}}>
                    <i class="{{icon}}" {{#if iconColor}}style="color: {{iconColor}};"{{/if}}></i>
                    {{!-- The three named tools carry a title for their tooltip but render
                          icon-only. `else if title` extends that to any icon-only tool:
                          an EMPTY label span is not free -- it is a flex child and picks
                          up the 3px margin-left in menubar.css, so it pads the button
                          asymmetrically. --}}
                    {{#if (eq name "settings")}}
                    {{else if (eq name "refresh")}}
                    {{else if (eq name "left-start-menu")}}
                    {{else if title}}
                    <span class="{{name}}-label">{{title}}</span>
                    {{/if}}
                </div>
                {{/each}}
            {{/each}}
        {{/each}}
    </div>

    {{!-- MIDDLE ZONE --}}
    <div class="blacksmith-menubar-middle">
        <div class="blacksmith-menubar-middle-tools">
            {{#each toolsByZone.middle}}
                {{#each this}}
                    {{#each tools}}
                    <div class="button {{name}} button-active{{#if (and toggleable active)}} tool-active{{/if}}" data-tooltip="{{#if tooltip}}{{tooltip}}{{else}}{{title}}{{/if}}" data-tool="{{name}}" data-tool-id="{{toolId}}"{{#if (or buttonNormalTint buttonSelectedTint)}} style="{{#if buttonNormalTint}}--button-normal-tint: {{buttonNormalTint}};{{/if}}{{#if buttonSelectedTint}} --button-selected-tint: {{buttonSelectedTint}};{{/if}}"{{/if}}>
                        <i class="{{icon}}" {{#if iconColor}}style="color: {{iconColor}};"{{/if}}></i>
                        {{#if title}}<span class="{{name}}-label">{{title}}</span>{{/if}}
                    </div>
                    {{/each}}
                {{/each}}
                {{#unless @last}}
                <div class="menu-divider line"></div>
                {{/unless}}
            {{/each}}
            {{!-- Overflow "..." button: shown via JS when middle zone content overflows --}}
            <div class="button menubar-overflow button-active" data-tool="menubar-overflow" data-tooltip="More tools" style="display: none;">
                <i class="fa-solid fa-ellipsis"></i>
            </div>
        </div>

        {{!-- NOTIFICATIONS --}}
        {{#if notifications.length}}
            <div class="menu-divider line"></div>
            <div class="menu-notifications">
                {{#each notifications}}
                <div class="menu-notification-item{{#if actionable}} notification-actionable{{/if}}{{#if pulse}} notification-pulse{{/if}}" data-notification-id="{{id}}">
                    <i class="{{icon}}"></i>
                    <span class="notification-content" data-tooltip="{{text}}">{{text}}</span>
                    <button class="notification-close" data-notification-id="{{id}}">&times;</button>
                </div>
                {{/each}}
            </div>
        {{/if}}
    </div>

    {{!-- RIGHT ZONE --}}
    <div class="blacksmith-menubar-right">
        {{!-- LEADER --}}
        {{!-- Active for the leader too, not only the GM: the leader's menu is where
              starting a vote now lives, so a control that looked read-only would be
              hiding their own capability. --}}
        <div class="button leader-section {{#if isGM}}button-active{{else}}{{#if isPartyLeader}}button-active{{else}}tool-readonly{{/if}}{{/if}}" data-tooltip="{{#if isGM}}Set the session leader.{{else}}{{#if isPartyLeader}}Start a vote.{{else}}Session leader.{{/if}}{{/if}}" data-tool="leader-section">
            <i class="fas fa-crown"></i>
            <span class="party-leader">{{leaderText}}</span>
        </div>
        {{!-- MOVEMENT --}}
        <div class="button movement {{#if isGM}}button-active{{else}}tool-readonly{{/if}}" data-tooltip="{{#if isGM}}Change Party Movement{{else}}Only the GM can change movement{{/if}}" data-tool="movement">
            <i class="fa-solid {{currentMovement.icon}} movement-icon"></i>
            <span class="movement-label">{{currentMovement.name}}</span>
        </div>
        {{!-- DYNAMIC RIGHT ZONE TOOLS (timer stays after this block — always rightmost) --}}
        {{#each toolsByZone.right}}
            {{#each this}}
                {{#each tools}}
                <div class="button {{name}} button-active{{#if (and toggleable active)}} tool-active{{/if}}" data-tooltip="{{#if tooltip}}{{tooltip}}{{else}}{{title}}{{/if}}" data-tool="{{name}}" data-tool-id="{{toolId}}"{{#if (or buttonNormalTint buttonSelectedTint)}} style="{{#if buttonNormalTint}}--button-normal-tint: {{buttonNormalTint}};{{/if}}{{#if buttonSelectedTint}} --button-selected-tint: {{buttonSelectedTint}};{{/if}}"{{/if}}>
                    <i class="{{icon}}" {{#if iconColor}}style="color: {{iconColor}};"{{/if}}></i>
                    {{#if title}}<span class="{{name}}-label">{{title}}</span>{{/if}}
                </div>
                {{/each}}
            {{/each}}
        {{/each}}
        {{!-- WORLD TIME — the in-world clock, immediately left of the session timer.

              The two belong together and answer different questions: the session
              timer is how long the TABLE has left, the world clock is what time it
              is THERE. Pairing them is why this sits inside the timer's block
              rather than among the dynamic tools above, which reorder as modules
              register and would eventually push the two clocks apart.

              Read-only for everyone, the GM included. Advancing time is a separate
              capability from reporting it, and a readout that silently did nothing
              on click would read as broken. --}}
        <div class="button worldtime-section tool-readonly{{#if worldTime.isNight}} is-night{{/if}}" data-tooltip="In-world time of day." data-tool="worldtime-section">
            <i class="{{worldTime.icon}}"></i>
            <span class="world-time">{{worldTime.text}}</span>
        </div>
        {{!-- SESSION TIMER — always last in the right zone --}}
        <div class="button timer-section default {{#if isGM}}button-active{{else}}tool-readonly{{/if}} {{#if isWarning}}warning{{/if}} {{#if isExpired}}expired{{/if}}" data-tooltip="{{#if isGM}}Set the session time.{{else}}Session time.{{/if}}" style="--progress: {{timerProgress}}%" data-tool="timer-section">
            <i class="fas fa-eclipse"></i>
            <span class="session-timer">{{timerText}}</span>
        </div>
    </div>
</div>

{{!-- **************** SECONDARY BAR **************** --}}
{{#if secondaryBar.isOpen}}
<div class="blacksmith-menubar-secondary" 
     data-bar-type="{{secondaryBar.type}}"
     style="height: {{secondaryBar.height}}px;">
    {{#if secondaryBar.hasCustomTemplate}}
        {{!-- Custom template (e.g., combat bar, encounter bar) --}}
        {{#if (eq secondaryBar.type "combat")}}
        {{> "menubar-combat" secondaryBar.data}}
        {{else}}
            {{!-- An "encounter" branch used to sit here naming a `menubar-encounter`
                  partial that does not exist and never did. It was unreachable --
                  `hasCustomTemplate` is `!!config.templatePath` and the encounter bar
                  registers none -- so it was waiting to fire the day someone gave it
                  one, and would then have failed on a missing partial INSTEAD of
                  falling through to the dynamic lookup below, which handles exactly
                  that case correctly. --}}
            {{!-- Dynamic custom template --}}
            {{> (lookup . (concat "menubar-" secondaryBar.type)) secondaryBar.data}}
        {{/if}}
    {{else}}
        {{!-- Default tool-based template --}}
        {{> "menubar-secondary-default" secondaryBar}}
    {{/if}}
</div>
{{/if}}
