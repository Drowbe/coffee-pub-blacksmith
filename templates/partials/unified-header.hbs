{{!-- Unified Header Partial - Uses EXACT existing CSS classes --}}
<div class="cpb-dialog-header-sticky">
    <div class="cpb-dialog-header">

        <div class="cpb-dialog-header-content">

            {{!-- HEADER ICON, or the actor's portrait when there is one.

                  The whole point of the circle is "what is rolling", so a portrait
                  belongs in it and a generic die belongs there only when nobody in
                  particular is rolling. The roll window has an actor; the skill
                  check dialog does not and keeps its d20. --}}
            <div class="cpb-dialog-dice-icon">
                {{#if actorPortrait}}
                    <img src="{{actorPortrait}}" alt="{{actorName}}" class="cpb-actor-portrait">
                {{else}}
                    <i class="{{diceIcon}}"></i>
                {{/if}}
            </div>
            {{!-- HEADER TITLE. The actor leads the subtitle rather than occupying a
                  banner of its own: it qualifies the roll ("Favia Gita, an
                  Investigation check"), which is a caption, not a headline. --}}
            <div class="cpb-dialog-title-section">

                <div class="cpb-dialog-main-title">{{mainTitle}}</div>
                {{!-- The actor's name is the subtitle, in the subtitle's own voice.
                      It was lifted to white and bold while a trail of qualifiers
                      followed it -- the roll type, the DC, whether it was a group
                      roll -- each of which the window already states somewhere it
                      belongs: the title names the roll, the DC has its own box. A
                      caption repeating three things the reader can see is noise,
                      and emphasising the one word that is not a repeat made it a
                      second headline under the first. --}}
                <div class="cpb-dialog-subtitle">{{#if actorName}}{{actorName}}{{#if subtitle}} &middot; {{/if}}{{/if}}{{subtitle}}</div>
            </div>
            <!-- HEADER CONTROLS -->
            <div class="cpb-dialog-controls">
                <!-- Additional Toggles (only for skill check dialog) -->
                {{#if showToggles}}
                    <!-- Cinematic Toggle -->
                    <div class="cpb-toggle-container">
                        <span class="cpb-toggle-label">Cinematic</span>
                        <div class="cpb-toggle">
                            <input type="checkbox" name="isCinematic" id="isCinematic" {{#if isCinematic}}checked{{/if}}>
                            <label for="isCinematic" class="cpb-toggle-slider"></label>
                        </div>
                    </div>
                    <!-- Show DC Toggle -->
                    <div class="cpb-toggle-container">
                        <span class="cpb-toggle-label">Show DC</span>
                        <div class="cpb-toggle">
                            <input type="checkbox" name="showDC" id="showDC" {{#if showDC}}checked{{/if}}>
                            <label for="showDC" class="cpb-toggle-slider"></label>
                        </div>
                    </div>
                    <!-- Group DC Toggle -->
                    <div class="cpb-toggle-container">
                        <span class="cpb-toggle-label">Group DC</span>
                        <div class="cpb-toggle">
                            <input type="checkbox" name="groupRoll" id="groupRoll" {{#if groupRoll}}checked{{/if}}>
                            <label for="groupRoll" class="cpb-toggle-slider"></label>
                        </div>
                    </div>
                {{/if}}
                <!-- Roll Mode Selector -->
                <div class="cpb-form-group">
                    <div class="cpb-form-fields">
                        {{!-- The framework's select. `.cpb-select` was a local rule
                              carrying a TOGGLE's dimensions -- 35x20 with a 50px
                              radius -- which is why the control was the size it was
                              and why its options fell back to the browser's. --}}
                        <select name="rollMode" class="blacksmith-select">
                            <option value="roll" {{#if (eq rollMode "roll")}}selected{{/if}}>Public Roll</option>
                            <option value="gmroll" {{#if (eq rollMode "gmroll")}}selected{{/if}}>Private GM Roll</option>
                            <option value="blindroll" {{#if (eq rollMode "blindroll")}}selected{{/if}}>Blind GM Roll</option>
                            <option value="selfroll" {{#if (eq rollMode "selfroll")}}selected{{/if}}>Self Roll</option>
                        </select>
                    </div>
                </div>
                {{!-- DC Box. Read-only means it REPORTS a DC, so with none to report
                      there is nothing to render -- an empty box with a label is a
                      control that looks broken rather than a roll without a DC. The
                      editable form always renders, because there the box is how a DC
                      is entered and its emptiness is the starting state. --}}
                {{#if isReadOnly}}
                    {{#if hasDC}}
                    <div class="cpb-dc-display">
                        <div class="cpb-dc-box">
                            <div class="cpb-dc-label">DC</div>
                            <div class="cpb-dc-readonly">{{dcValue}}</div>
                        </div>
                    </div>
                    {{/if}}
                {{else}}
                <div class="cpb-dc-display">
                    <div class="cpb-dc-box">
                        <div class="cpb-dc-label">DC</div>
                        <input type="number" name="dc" class="cpb-dc-input" value="{{dcValue}}" placeholder="" min="1" max="30">
                    </div>
                </div>
                {{/if}}
            </div>
        </div>
    </div>
</div>
