{{!--
    Default Secondary Bar Template - Left / Middle / Right zones.

    Each zone is identical apart from which list it walks, and the per-item markup lives in
    `menubar-secondary-item` so a new item kind is added once rather than three times.
--}}
<div class="secondary-bar-toolbar">
    {{!-- LEFT ZONE --}}
    <div class="secondary-bar-zone secondary-bar-zone-left">
        {{#each zones.left}}
        <div class="secondary-bar-group-container">
            {{#if ../groupBannerEnabled}}
            <div class="secondary-bar-group-banner" style="background-color: {{#if bannerColor}}{{bannerColor}}{{else}}{{../groupBannerColor}}{{/if}};">
                <span class="secondary-bar-group-banner-text">{{id}}</span>
            </div>
            {{/if}}
            <div class="secondary-bar-group-items">
                {{#each items}}
                {{> "menubar-secondary-item" this groupId=../id}}
                {{/each}}
            </div>
        </div>
        {{/each}}
    </div>

    {{!-- MIDDLE ZONE --}}
    <div class="secondary-bar-zone secondary-bar-zone-middle">
        {{#each zones.middle}}
        <div class="secondary-bar-group-container">
            {{#if ../groupBannerEnabled}}
            <div class="secondary-bar-group-banner" style="background-color: {{#if bannerColor}}{{bannerColor}}{{else}}{{../groupBannerColor}}{{/if}};">
                <span class="secondary-bar-group-banner-text">{{id}}</span>
            </div>
            {{/if}}
            <div class="secondary-bar-group-items">
                {{#each items}}
                {{> "menubar-secondary-item" this groupId=../id}}
                {{/each}}
            </div>
        </div>
        {{/each}}
    </div>

    {{!-- RIGHT ZONE --}}
    <div class="secondary-bar-zone secondary-bar-zone-right">
        {{#each zones.right}}
        <div class="secondary-bar-group-container">
            {{#if ../groupBannerEnabled}}
            <div class="secondary-bar-group-banner" style="background-color: {{#if bannerColor}}{{bannerColor}}{{else}}{{../groupBannerColor}}{{/if}};">
                <span class="secondary-bar-group-banner-text">{{id}}</span>
            </div>
            {{/if}}
            <div class="secondary-bar-group-items">
                {{#each items}}
                {{> "menubar-secondary-item" this groupId=../id}}
                {{/each}}
            </div>
        </div>
        {{/each}}
    </div>
</div>
