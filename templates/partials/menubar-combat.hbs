{{!-- Two rows with different jobs.

     The DATA ROW is a fixed height and holds readouts only — round and turn,
     challenge rating, and later health, balance, and timers. It is fixed
     because every registered item sizes itself from
     `--blacksmith-menubar-secondary-height`, which the row shadows to its own
     height: at the combat row's scale those items inflate (item minimums are
     bar height minus chrome, applied to width as well as height) and progress
     bars become slabs. Giving them a constant basis is the whole point.

     The COMBAT ROW scales with the user's size setting because portraits need
     it, and holds the controls: menus, turn navigation, portraits, graveyard,
     and the begin/end button.

     Data on top so it never moves when the combat row resizes or the portrait
     strip comes and goes. --}}
<div class="combat-bar-rows">

<div class="combat-data-row">
    {{> "menubar-secondary-default" this}}
</div>

{{!-- Out of combat this row holds only the GM's menus, so for a player it
      would be an empty strip. The data row is the whole bar for them. --}}
{{#if showCombatRow}}
<div class="combat-tracker-bar">

    {{!-- Combat Controls and Portraits Group --}}
    <div class="combat-portraits-group">
        {{!-- All controls in one row: Tracker | prev | left arrow | portraits | right arrow | next | Action --}}
        <div class="combat-portraits-scroll-wrapper">
        {{!-- Encounter-level menus (GM). Not gated on isActive: rolling
              initiative is what you do *before* combat starts. Show/Hide
              Combat Tracker lives in the Encounter menu. --}}
        {{#if isGM}}
        <div class="combatbar-button-control-container action-button combat-bar-edge-button">
            {{!-- In combat these are two menu openers, because the row's space
                  belongs to the portraits. Out of combat the menus' contents
                  are pulled out and rendered below as ordinary bar buttons —
                  same actions, no menu to open. --}}
            {{#if isInCombat}}
            <a class="combatbar-button action-type-general"
               aria-label="Encounter"
               role="button"
               data-tooltip="Encounter"
               data-control="encounterMenu">
                <i class="fas fa-swords"></i>
            </a>
            <a class="combatbar-button action-type-general"
               aria-label="Tokens"
               role="button"
               data-tooltip="Tokens"
               data-control="tokensMenu">
                <i class="fa-solid fa-users-viewfinder"></i>
            </a>
            {{/if}}
            {{#if isInCombat}}
            <a class="combatbar-button action-type-general"
               aria-label="Initiatives"
               role="button"
               data-tooltip="Initiatives"
               data-control="initiativeMenu">
                <i class="fas fa-dice-d20"></i>
            </a>
            {{/if}}
        </div>
        {{/if}}

        {{!-- Out-of-combat actions as real bar buttons. They use the shared
              secondary-bar item classes rather than combatbar-button ones, so
              they inherit the default button look instead of overriding it. --}}
        {{#unless isInCombat}}
        <div class="combat-bar-actions">
            {{#each barActions}}
            <a class="secondary-bar-item combat-bar-action"
               role="button"
               data-tooltip="{{name}}"
               data-bar-action="{{id}}">
                <i class="{{icon}}"></i>
                <span class="secondary-bar-item-label">{{name}}</span>
            </a>
            {{/each}}
        </div>
        {{/unless}}

        {{#if isGM}}
        {{#if isActive}}
            <div class="combatbar-button-control-container combat-bar-prev-buttons">
            {{!-- Previous Round Button (GM Only, After Combat Started, Not Round 1) --}}
            {{#if (gt currentRound 1)}}
                <a class="combatbar-button" 
                aria-label="Previous Round" 
                role="button" 
                data-tooltip="Previous Round" 
                data-control="previousRound">
                    <i class="fas fa-chevrons-left"></i>
                </a>
            {{else}}
                    <span class="combatbar-button-disabled" data-tooltip="No Previous Round">
                        <i class="fas fa-chevrons-left"></i>
                    </span>
            {{/if}}
            {{!-- Previous Turn Button (GM Only, After Combat Started, Not Turn 1) --}}
            {{#if (gt currentTurn 1)}}
                <a class="combatbar-button" 
                aria-label="Previous Turn" 
                role="button" 
                data-tooltip="Previous Turn" 
                data-control="previousTurn">
                    <i class="fas fa-chevron-left"></i>
                </a>
            {{else}}
                <span class="combatbar-button-disabled" data-tooltip="No Previous Turn">
                    <i class="fas fa-chevron-left"></i>
                </span>
            {{/if}}

            </div>
        {{/if}}
        {{/if}}
        {{!-- The portrait strip and its scroll arrows only mean anything with
              combatants to show. Out of combat the bar keeps its menus and
              drops the strip entirely. --}}
        {{#if isInCombat}}
            <button type="button" class="combat-scroll-arrow combat-scroll-left" aria-label="Scroll combatants left" data-tooltip="Scroll combatants left" data-control="scrollCombatantsLeft">
                <i class="fa-solid fa-arrow-left-from-arc"></i>
            </button>
        {{!-- Combat Portraits --}}
        <div class="combat-portraits">
        {{#each combatants}}
               {{!-- `disposition-*` colours the BUTTON ITSELF — see the note in
                     menubar-combatbar.css for the four surfaces tried before it and why the
                     fill won. Whose turn it is therefore lives on the border and an inner glow.
                     The word is in the hover card, not here.

                     `shape-*` is this client's Portrait Shape setting, and it governs the
                     portrait and its health reading together. The bunting is unaffected by it. --}}
               <div class="combat-portrait-container disposition-{{dispositionKey}} {{#if isSquarePortrait}}shape-square{{else}}shape-round{{/if}} {{#if isCurrent}}current{{/if}} {{#if isDefeated}}defeated{{/if}} {{#if isHidden}}combat-token-hidden{{/if}}"
                    data-combatant-id="{{id}}"
                    data-disposition="{{dispositionKey}}">
                   {{!-- TWO READINGS, NOT ONE READING IN TWO COSTUMES. Round wraps the portrait
                         in a ring; square lays a bar across the bottom of it. A square ring was
                         built first and dropped: it drained from a corner, because an SVG rect's
                         path starts after its first corner radius, and a rectangle has no
                         equivalent of twelve o'clock to start at. Left-to-right needs no
                         explaining. See the note in getCombatData.

                         BOTH DRAW THEIR EMPTY PART. Without a track the depleted portion was
                         simply absent, which reads as a control that failed to render rather
                         than a bar that is part empty — the same reason an ordinary progress bar
                         shows its groove. --}}
                   {{#if isSquarePortrait}}
                   <div class="combat-portrait-healthbar">
                       <div class="combat-portrait-healthbar-fill {{healthClass}}"
                            style="width: {{healthBarPercent}}%"></div>
                   </div>
                   {{else}}
                   <div class="combat-portrait-healthring">
                       <svg width="{{svgSize}}" height="{{svgSize}}" viewBox="0 0 {{svgSize}} {{svgSize}}" class="{{healthClass}}">
                           <circle class="combat-portrait-ring-track"
                               cx="{{svgCenter}}"
                               cy="{{svgCenter}}"
                               r="{{svgRadius}}"
                               fill="none"
                               stroke-width="{{svgStrokeWidth}}"
                           />
                           <circle
                               cx="{{svgCenter}}"
                               cy="{{svgCenter}}"
                               r="{{svgRadius}}"
                               fill="none"
                               stroke-width="{{svgStrokeWidth}}"
                               stroke-dasharray="{{healthCircumference}}"
                               stroke-dashoffset="{{healthDashOffset}}"
                               transform="rotate(-90, {{svgCenter}}, {{svgCenter}})"
                               {{#unless healthRingHidden}}{{#if (gt currentHP 0)}}style="transition: stroke-dashoffset 0.3s ease-in-out, stroke 0.3s ease-in-out"{{/if}}{{/unless}}
                           />
                       </svg>
                   </div>
                   {{/if}}
                   <div class="combat-portrait-image">
                       <img src="{{portrait}}" alt="{{name}}" onerror="this.src='modules/coffee-pub-blacksmith/images/portraits/portrait-noimage.webp'">
                       {{!-- Inside the image wrapper so the round or square mask
                            clips it with the portrait. --}}
                       {{#if bloodOverlay}}
                       <img class="combat-portrait-blood" src="{{bloodOverlay}}" alt="" aria-hidden="true">
                       {{/if}}
                   </div>
                   
                   {{!-- Dead overlay - always show for defeated characters --}}
                   {{#if isDefeated}}
                   <div class="combat-portrait-dead-overlay" data-tooltip="Defeated">
                       <i class="fas fa-skull"></i>
                   </div>
                   {{/if}}
                   
                   {{!-- Initiative dice - only show for living characters that need initiative --}}
                   {{#if needsInitiative}}
                   {{#unless isDefeated}}
                   <div class="combat-portrait-initiative-dice {{#unless canRollInitiative}}waiting{{/unless}}">
                       {{#if canRollInitiative}}
                       <a class="combatant-control roll" 
                          aria-label="Roll Initiative" 
                          role="button" 
                          data-tooltip="COMBAT.InitiativeRoll" 
                          data-control="rollInitiative"
                          data-combatant-id="{{id}}">
                           <i class="fas fa-dice-d20"></i>
                       </a>
                       {{else}}
                       <span class="waiting-initiative" data-tooltip="Waiting for initiative">
                           <i class="fas fa-hourglass-half"></i>
                       </span>
                       {{/if}}
                   </div>
                   {{/unless}}
                   {{/if}}
               </div>
        {{/each}}
        </div>

            <button type="button" class="combat-scroll-arrow combat-scroll-right" aria-label="Scroll combatants right" data-tooltip="Scroll combatants right" data-control="scrollCombatantsRight">
                <i class="fa-solid fa-arrow-right-from-arc"></i>
            </button>
        {{/if}}

        {{!-- Graveyard: the dead that "hide dead" has taken off the strip.
              Sits beside the portraits, before the turn navigation, because it
              holds portraits rather than being a control. Absent when the
              setting is off, since they are still on the bar. --}}
        {{#if hasGraveyard}}
        <div class="combatbar-button-control-container action-button combat-bar-edge-button">
            <a class="combatbar-button action-type-general"
               aria-label="Graveyard"
               role="button"
               data-tooltip="Graveyard ({{graveyardCount}})"
               data-control="graveyardMenu">
                <i class="fa-solid fa-skull"></i>
            </a>
        </div>
        {{/if}}

        {{#if isGM}}
        {{#if isActive}}
        <div class="combatbar-button-control-container combat-bar-next-buttons">
            {{!-- Next Turn Button (GM Only, After Combat Started) --}}
            <a class="combatbar-button" 
               aria-label="Next Turn" 
               role="button" 
               data-tooltip="Next Turn" 
               data-control="nextTurn">
                <i class="fas fa-chevron-right"></i>
            </a>
            {{!-- Next Round Button (GM Only, After Combat Started) --}}
            <a class="combatbar-button" 
               aria-label="Next Round" 
               role="button" 
               data-tooltip="Next Round" 
               data-control="nextRound">
                <i class="fas fa-chevrons-right"></i>
            </a>
        </div>
        {{/if}}
        {{/if}}

        {{!-- Action Button (End Combat, Begin Combat, etc.) - inside scroll wrapper --}}
        {{#if actionButton}}
            <div class="combatbar-button-control-container action-button combat-bar-edge-button">
                <a class="combatbar-button  action-type-{{actionButton.type}}" 
                aria-label="{{actionButton.label}}" 
                role="button" 
                data-tooltip="{{actionButton.tooltip}}" 
                data-control="{{actionButton.control}}">
                    <i class="fas {{actionButton.icon}}"></i>
                </a>
            </div>
        {{/if}}
        </div>

    </div>

</div>
{{/if}}

</div>
