{{!--
    One secondary bar item, whatever kind it is.

    Extracted because the three zones rendered identical markup three times over, so every new kind
    cost three copies and any fix had to be made three times or silently apply to one zone. Invoked
    as {{> "menubar-secondary-item" this groupId=../id}} -- `groupId` is passed explicitly rather
    than reached for with `../id`, which does not resolve the same way from inside a partial.
--}}
{{#if (eq kind "info")}}
<div class="secondary-bar-item secondary-bar-item-info"
     data-item-id="{{itemId}}"
     data-group-id="{{groupId}}"
     data-tooltip="{{#if tooltip}}{{tooltip}}{{else}}{{displayLabel}}{{/if}}"
     title="{{#if tooltip}}{{tooltip}}{{else}}{{displayLabel}}{{/if}}"
     {{#if (or buttonColor borderColor)}}
     style="{{#if buttonColor}}background-color: {{buttonColor}};{{/if}}{{#if borderColor}} border-color: {{borderColor}};{{/if}}"
     {{/if}}>
    {{#if image}}<img class="secondary-bar-item-image" src="{{image}}" alt="">{{/if}}
    {{#if icon}}<i class="{{icon}}" {{#if iconColor}}style="color: {{iconColor}};"{{/if}}></i>{{/if}}
    {{#if displayLabel}}<span class="secondary-bar-item-label">{{displayLabel}}</span>{{/if}}
    {{#if displayValue}}<span class="secondary-bar-item-value" {{#if iconColor}}style="color: {{iconColor}};"{{/if}}>{{displayValue}}</span>{{/if}}
</div>

{{else if (eq kind "statchip")}}
{{!-- A readout that says what KIND of number it is. `tone` drives an accent on the value and a
      hairline under it, never a filled background: this sits in a row of readouts, and a fill would
      read as a button. --}}
<div class="secondary-bar-item secondary-bar-item-statchip tone-{{tone}} emphasis-{{emphasis}}"
     data-item-id="{{itemId}}"
     data-group-id="{{groupId}}"
     data-tone="{{tone}}"
     data-emphasis="{{emphasis}}"
     data-tooltip="{{#if tooltip}}{{tooltip}}{{else}}{{displayLabel}}{{/if}}"
     title="{{#if tooltip}}{{tooltip}}{{else}}{{displayLabel}}{{/if}}">
    {{!-- Two tones, label then value, read as one pill. The word REPLACES the icon rather than
          joining it: an icon and a word saying the same thing spend two glyphs of width on one
          meaning, and this row has none to spare. --}}
    {{#if displayLabel}}
    <span class="secondary-bar-item-label">{{displayLabel}}</span>
    {{else if icon}}
    <span class="secondary-bar-item-label"><i class="{{icon}} secondary-bar-item-statchip-icon"></i></span>
    {{/if}}
    {{#if displayValue}}<span class="secondary-bar-item-value">{{displayValue}}</span>{{/if}}
</div>

{{else if (eq kind "portraitstat")}}
{{!-- A standing that belongs to a PERSON. Round and ringed so it cannot be mistaken for a quantity
      chip at a glance; the name stays in the tooltip, where there is room for it. --}}
<div class="secondary-bar-item secondary-bar-item-portraitstat rank-{{rank}} emphasis-{{emphasis}}"
     data-item-id="{{itemId}}"
     data-group-id="{{groupId}}"
     data-rank="{{rank}}"
     data-emphasis="{{emphasis}}"
     data-tooltip="{{#if tooltip}}{{tooltip}}{{else}}{{displayLabel}}{{/if}}"
     title="{{#if tooltip}}{{tooltip}}{{else}}{{displayLabel}}{{/if}}">
    {{!-- The portrait says WHO. The label has to say what the number is, or the chip is a face and a
          digit with no stated relationship and the only way to find out is to hover -- which is not
          a readout, it is a puzzle. --}}
    <span class="secondary-bar-item-portraitstat-frame">
        {{#if image}}
        <img class="secondary-bar-item-portraitstat-image" src="{{image}}" alt="">
        {{else}}
        <i class="{{#if icon}}{{icon}}{{else}}fa-solid fa-user{{/if}} secondary-bar-item-portraitstat-empty"></i>
        {{/if}}
    </span>
    {{#if displayLabel}}<span class="secondary-bar-item-label">{{displayLabel}}</span>{{/if}}
    {{#if displayValue}}<span class="secondary-bar-item-value">{{displayValue}}</span>{{/if}}
</div>

{{else if (eq kind "gaugechip")}}
{{!-- A percentage as a filled METER, not a ring.

      It was a ring twice: first a conic gradient masked into one, then a stroked SVG circle. Both
      read badly, and the reason is the size rather than the technique -- at the height of this row a
      dial is about twenty pixels across, which is too little arc to judge a proportion from and too
      little room for the rim to survive antialiasing. A horizontal meter of the same width shows the
      same fraction with an order of magnitude more resolution, and it sits in the pill language the
      rest of the row already speaks. --}}
<div class="secondary-bar-item secondary-bar-item-gaugechip emphasis-{{emphasis}}"
     data-item-id="{{itemId}}"
     data-group-id="{{groupId}}"
     data-tooltip="{{#if tooltip}}{{tooltip}}{{else}}{{displayLabel}}{{/if}}"
     title="{{#if tooltip}}{{tooltip}}{{else}}{{displayLabel}}{{/if}}">
    {{#if displayLabel}}<span class="secondary-bar-item-label">{{displayLabel}}</span>{{/if}}
    <span class="secondary-bar-item-gaugechip-readout">
        <span class="secondary-bar-item-gaugechip-meter">
            <span class="secondary-bar-item-gaugechip-fill" style="width: {{gaugePercent}}%;{{#if gaugeColor}} background-color: {{gaugeColor}};{{/if}}"></span>
        </span>
        {{#if displayValue}}<span class="secondary-bar-item-value">{{displayValue}}</span>{{/if}}
    </span>
</div>

{{else if (eq kind "sparkchip")}}
{{!-- A value with its recent history behind it. Columns rather than a polyline, and CSS rather than
      SVG: at this size a line is one or two pixels of slope per point and reads as noise, where
      columns read as a shape. Heights are precomputed into percentages by the item preparation, so
      the template does no maths and a series update is a handful of style writes. --}}
<div class="secondary-bar-item secondary-bar-item-sparkchip tone-{{tone}} emphasis-{{emphasis}}"
     data-item-id="{{itemId}}"
     data-group-id="{{groupId}}"
     data-tone="{{tone}}"
     data-emphasis="{{emphasis}}"
     data-tooltip="{{#if tooltip}}{{tooltip}}{{else}}{{displayLabel}}{{/if}}"
     title="{{#if tooltip}}{{tooltip}}{{else}}{{displayLabel}}{{/if}}">
    {{#if displayLabel}}<span class="secondary-bar-item-label">{{displayLabel}}</span>{{/if}}
    <span class="secondary-bar-item-sparkchip-readout">
        <span class="secondary-bar-item-sparkchip-plot">
            {{#each sparkBars}}
            <span class="secondary-bar-item-sparkchip-period">
                <span class="secondary-bar-item-sparkchip-bar is-primary{{#if isLast}} is-latest{{/if}}" style="height: {{height}}%;"></span>
                {{#if hasPair}}
                <span class="secondary-bar-item-sparkchip-bar is-paired{{#if isLast}} is-latest{{/if}}" style="height: {{heightB}}%;"></span>
                {{/if}}
            </span>
            {{/each}}
        </span>
        {{#if displayValue}}<span class="secondary-bar-item-value">{{displayValue}}</span>{{/if}}
    </span>
</div>

{{else if (eq kind "nameplate")}}
{{!-- A person and what they did, given room to say it. Two stacked lines beside a portrait rather
      than a chip, because this is the one readout meant to be looked AT rather than glanced past.
      Its own kind and not a large `portraitstat`: the stacked text block is different markup, and
      overloading a size flag would have one kind rendering two layouts. --}}
<div class="secondary-bar-item secondary-bar-item-nameplate rank-{{rank}}"
     data-item-id="{{itemId}}"
     data-group-id="{{groupId}}"
     data-rank="{{rank}}"
     data-emphasis="{{emphasis}}"
     data-tooltip="{{#if tooltip}}{{tooltip}}{{else}}{{displayLabel}}{{/if}}"
     title="{{#if tooltip}}{{tooltip}}{{else}}{{displayLabel}}{{/if}}">
    <span class="secondary-bar-item-nameplate-frame">
        {{#if image}}
        <img class="secondary-bar-item-nameplate-image" src="{{image}}" alt="">
        {{else}}
        <i class="{{#if icon}}{{icon}}{{else}}fa-solid fa-trophy{{/if}} secondary-bar-item-nameplate-empty"></i>
        {{/if}}
    </span>
    <span class="secondary-bar-item-nameplate-text">
        <span class="secondary-bar-item-nameplate-name">{{#if displayLabel}}{{displayLabel}}{{else}}&nbsp;{{/if}}</span>
        <span class="secondary-bar-item-nameplate-detail">{{#if displayValue}}{{displayValue}}{{else}}&nbsp;{{/if}}</span>
    </span>
</div>

{{else if (eq kind "progressbar")}}
<div class="secondary-bar-item secondary-bar-item-progressbar"
     data-item-id="{{itemId}}"
     data-group-id="{{groupId}}"
     data-tooltip="{{#if tooltip}}{{tooltip}}{{else}}{{title}}{{/if}}"
     title="{{#if tooltip}}{{tooltip}}{{else}}{{title}}{{/if}}"
     style="width: {{progressbarWidth}};">
    <div class="secondary-bar-item-progressbar-caption">
        {{#if icon}}<i class="{{icon}} secondary-bar-item-progressbar-icon"></i>{{/if}}
        {{#if title}}<span class="secondary-bar-item-progressbar-title">{{title}}</span>{{/if}}
    </div>
    {{#if leftIcon}}<i class="{{leftIcon}} secondary-bar-item-progressbar-icon-outside-left"></i>{{/if}}
    <div class="secondary-bar-item-progressbar-bar" style="height: {{progressbarHeight}}; border-color: {{borderColor}}; background-color: {{barColor}};">
        <div class="secondary-bar-item-progressbar-track">
            <div class="secondary-bar-item-progressbar-fill" style="width: {{percentProgress}}%; background-color: {{progressColor}};"></div>
        </div>
        {{#if leftLabel}}<span class="secondary-bar-item-progressbar-left-label">{{leftLabel}}</span>{{/if}}
        {{#if rightLabel}}<span class="secondary-bar-item-progressbar-right-label">{{rightLabel}}</span>{{/if}}
    </div>
    {{#if rightIcon}}<i class="{{rightIcon}} secondary-bar-item-progressbar-icon-outside-right"></i>{{/if}}
</div>

{{else if (eq kind "balancebar")}}
<div class="secondary-bar-item secondary-bar-item-balancebar"
     data-item-id="{{itemId}}"
     data-group-id="{{groupId}}"
     data-tooltip="{{#if tooltip}}{{tooltip}}{{else}}{{title}}{{/if}}"
     title="{{#if tooltip}}{{tooltip}}{{else}}{{title}}{{/if}}"
     style="width: {{balancebarWidth}};">
    <div class="secondary-bar-item-balancebar-caption">
        {{#if icon}}<i class="{{icon}} secondary-bar-item-balancebar-icon"></i>{{/if}}
        {{#if title}}<span class="secondary-bar-item-balancebar-title">{{title}}</span>{{/if}}
    </div>
    {{#if leftIcon}}<i class="{{leftIcon}} secondary-bar-item-balancebar-icon-outside-left"></i>{{/if}}
    <div class="secondary-bar-item-balancebar-bar" style="height: {{balancebarHeight}}; border-color: {{borderColor}};">
        <div class="secondary-bar-item-balancebar-left" style="background-color: {{barColorLeft}};"></div>
        <div class="secondary-bar-item-balancebar-right" style="background-color: {{barColorRight}};"></div>
        <div class="secondary-bar-item-balancebar-marker" style="left: {{balancebarMarkerLeftPercent}}%; background-color: {{markerColor}};"></div>
        {{!-- Extra needles on the same scale. The bar measures one relationship; a second reading of
              that relationship belongs on the same axis, not on a second bar. --}}
        {{#each balancebarMarkers}}
        <div class="secondary-bar-item-balancebar-marker-extra{{#if fromBottom}} from-bottom{{/if}}"
             style="left: {{leftPercent}}%;{{#if color}} background-color: {{color}};{{/if}}"
             data-tooltip="{{tooltip}}"
             title="{{tooltip}}"></div>
        {{/each}}
        {{#if leftLabel}}<span class="secondary-bar-item-balancebar-left-label">{{leftLabel}}</span>{{/if}}
        {{#if rightLabel}}<span class="secondary-bar-item-balancebar-right-label">{{rightLabel}}</span>{{/if}}
    </div>
    {{#if rightIcon}}<i class="{{rightIcon}} secondary-bar-item-balancebar-icon-outside-right"></i>{{/if}}
</div>

{{else}}
<div class="secondary-bar-item {{#if active}}active{{/if}}"
     data-item-id="{{itemId}}"
     data-group-id="{{groupId}}"
     data-tooltip="{{#if tooltip}}{{tooltip}}{{else}}{{label}}{{/if}}"
     title="{{#if tooltip}}{{tooltip}}{{else}}{{label}}{{/if}}"
     {{#if (or buttonColor borderColor)}}
     style="{{#if buttonColor}}background-color: {{buttonColor}};{{/if}}{{#if borderColor}} border-color: {{borderColor}};{{/if}}"
     {{/if}}>
    {{#if image}}
    <img src="{{image}}" class="secondary-bar-item-image" alt="{{#if label}}{{label}}{{else}}{{tooltip}}{{/if}}">
    {{else}}
    <i class="{{icon}}" {{#if iconColor}}style="color: {{iconColor}};"{{/if}}></i>
    {{/if}}
    {{#if label}}
    <span class="secondary-bar-item-label">{{label}}</span>
    {{/if}}
</div>
{{/if}}
