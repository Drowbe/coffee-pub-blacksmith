{{!-- Roll Configuration Window Template    roll-config-label       --}}
<div class="window-roll-normal foundry-style-window">
  {{!-- Unified Header --}}
  {{> "partial-unified-header" 
      diceIcon=diceIcon
      mainTitle=rollTitle
      subtitle=rollSubtitle
      rollMode=rollMode
      dcValue=dcValue
      isReadOnly=true
      showToggles=false
      actorName=actorName
      actorPortrait=actorPortrait
  }}
  
  <div class="roll-summary-row">
    <div class="roll-summary-item"><span class="label-small">Formula</span><span class="roll-formula">{{rollFormula}}</span></div>
  </div>

  {{#if rollAdvantageLabel}}
  <div class="roll-requested-mode{{#if lockRollAdvantage}} locked{{/if}}">
    <i class="fas fa-{{#if lockRollAdvantage}}lock{{else}}circle-info{{/if}}"></i>
    <span>Requested: <strong>{{rollAdvantageLabel}}</strong>{{#unless lockRollAdvantage}} (you may still choose){{/unless}}</span>
  </div>
  {{/if}}
  
  <div class="roll-body-scroll">
    <div class="roll-section">
      <div class="roll-config-grid">
        <div class="roll-config-item">
          <label class="label-small">Situational Bonus</label>
          <input type="number" class="roll-situational-bonus" name="situational-bonus" value="{{situationalBonus}}" min="-20" max="20" placeholder="Use + or - and the modifier value">
        </div>
        <div class="roll-config-item">
          <label class="label-small">Custom Modifier</label>
          <input type="text" class="roll-custom-modifier" name="custom-modifier" value="{{customModifier}}" placeholder="Use + or - and the modifier value">
        </div>
      </div>
    </div>

    <div class="roll-section">
      <div class="roll-section-header"><i class="fas fa-cog"></i> Roll Details</div>
      
      <div class="roll-details-grid">
        <div class="roll-detail-item">
          <span class="detail-label">Base Roll:</span>
          <span class="detail-value">{{baseRoll}}</span>
        </div>
        <div class="roll-detail-item">
          <span class="detail-label">Ability Modifier:</span>
          <span class="detail-value">{{abilityMod}}</span>
        </div>
        <div class="roll-detail-item">
          <span class="detail-label">Proficiency:</span>
          <span class="detail-value">{{proficiencyBonus}}</span>
        </div>
        <div class="roll-detail-item">
          <span class="detail-label">Other Modifiers:</span>
          <span class="detail-value">{{otherModifiers}}</span>
        </div>
      </div>
    </div>
  </div>
  
  <div class="roll-footer blacksmith-actions-fill">
    {{#if showDisadvantageButton}}
    <button type="button" class="blacksmith-window-btn-secondary roll-btn roll-disadvantage{{#if isDisadvantageRequested}} is-requested{{/if}}"><i class="fas fa-circle-minus"></i> Disadvantage</button>
    {{/if}}
    {{#if showNormalButton}}
    <button type="button" class="blacksmith-window-btn-secondary roll-btn roll-normal{{#if isNormalRequested}} is-requested{{/if}}"><i class="fas fa-dice-d20"></i> Normal</button>
    {{/if}}
    {{#if showAdvantageButton}}
    <button type="button" class="blacksmith-window-btn-secondary roll-btn roll-advantage{{#if isAdvantageRequested}} is-requested{{/if}}"><i class="fas fa-circle-plus"></i> Advantage</button>
    {{/if}}
  </div>
</div>
